# Copy to .env (make setup does this) and fill in what you use. Never commit .env.

# Data source override: ibm_extended (default) | kaggle_21
# CHURN_DATA_SOURCE=ibm_extended

# --- AI Retention Action Generator (used by the Streamlit app) ---
# Provider: gemini (default) | openai | anthropic | template
# With no key set, or on any API error, the app falls back to the
# deterministic template generator.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults are set in src/retention.py)
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
